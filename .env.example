# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Official WhatsApp Business Platform / Cloud API & Meta Embedded Signup V4 credentials
# Configured via Meta for Developers (developers.facebook.com)
# Note: META_APP_ID and VITE_META_APP_ID must be set to the same Meta App ID.
# Note: META_EMBEDDED_SIGNUP_CONFIG_ID and VITE_META_EMBEDDED_SIGNUP_CONFIG_ID must be set to the same Embedded Signup Configuration ID.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Backend-only Meta App Secret for OAuth authorization-code exchange and X-Hub-Signature-256 verification (never expose in frontend)
META_APP_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
# Canonical Meta webhook verification token
WHATSAPP_VERIFY_TOKEN=
# Optional alias of WHATSAPP_VERIFY_TOKEN (kept synchronized automatically)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Razorpay Subscription & Payment Gateway Configuration (STOQO Professional Monthly = ₹799 / 79900 paise)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Razorpay Recurring Subscription Plan ID for ₹799/month (79900 paise, INR, monthly)
RAZORPAY_PLAN_ID_MONTHLY_799=
RAZORPAY_WEBHOOK_SECRET=

