# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Official WhatsApp Business Platform / Cloud API credentials
# Configured via Meta for Developers (developers.facebook.com)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Canonical Meta webhook verification token
WHATSAPP_VERIFY_TOKEN=
# Optional alias of WHATSAPP_VERIFY_TOKEN (kept synchronized automatically)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Razorpay Subscription & Payment Gateway Configuration (STOQO Professional Monthly = ₹799 / 79900 paise)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Razorpay Recurring Subscription Plan ID for ₹799/month (79900 paise, INR, monthly)
RAZORPAY_PLAN_ID_MONTHLY_799=
RAZORPAY_WEBHOOK_SECRET=

