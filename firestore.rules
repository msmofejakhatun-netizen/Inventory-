rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMemberOfRestaurant(restaurantId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)) ||
        existsAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/restaurants/$(restaurantId)) && 
         get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid) ||
        (existsAfter(/databases/$(database)/documents/restaurants/$(restaurantId)) && 
         getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid)
      );
    }

    function getRestaurantUser(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)).data;
    }

    function isRestaurantOwner(restaurantId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
         get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid) ||
        (existsAfter(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
         getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)) &&
         getRestaurantUser(restaurantId).role == 'OWNER') ||
        (existsAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)) &&
         getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)).data.role == 'OWNER')
      );
    }

    function isRestaurantManager(restaurantId) {
      return isRestaurantOwner(restaurantId) || (
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)) &&
        getRestaurantUser(restaurantId).role in ['OWNER', 'MANAGER']
      );
    }

    function isStorekeeper(restaurantId) {
      return isRestaurantManager(restaurantId) || (
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)) &&
        getRestaurantUser(restaurantId).role == 'STOREKEEPER'
      );
    }

    function isValidProfileName(val) {
      return val is string &&
             val.trim().size() >= 2 &&
             val.trim().size() <= 60 &&
             !val.matches('.*[<>].*');
    }

    function isValidIssueSignature(sig) {
      return sig is map &&
             sig.status in ['PENDING', 'SIGNED'] && (
               sig.status == 'PENDING' || (
                 sig.signerUid is string &&
                 sig.signerUid == request.auth.uid &&
                 sig.signerName is string &&
                 sig.signerName.trim().size() > 0 &&
                 sig.signerName.size() <= 100 &&
                 sig.signedAt is string &&
                 sig.signatureDataUrl is string &&
                 sig.signatureDataUrl.matches('^data:image/png;base64,.*') &&
                 sig.signatureDataUrl.size() <= 130000
               )
             );
    }

    function isValidIssueDateNotFuture(issueDate) {
      let parts = issueDate.split('-');
      return issueDate is string &&
             issueDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             parts.size() == 3 &&
             int(parts[0]) >= 2000 &&
             int(parts[0]) <= 2100 &&
             int(parts[1]) >= 1 &&
             int(parts[1]) <= 12 &&
             int(parts[2]) >= 1 &&
             int(parts[2]) <= 31 &&
             timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) <= request.time + duration.value(14, 'h');
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidIssueSessionDraft(data, restaurantId, draftId) {
      return data.keys().hasAll([
               'draftId', 'draftSessionId', 'restaurantId', 'actorUid', 'status',
               'departmentId', 'shift', 'issueDate', 'selectedReceiverUid', 'receivedByName',
               'searchQuery', 'selectedItemId', 'quantityInput', 'cartItems',
               'includeManagerSignature', 'managerSignatureDataUrl', 'updatedAt', 'updatedAtIso'
             ]) &&
             data.keys().hasOnly([
               'draftId', 'draftSessionId', 'restaurantId', 'actorUid', 'status',
               'departmentId', 'shift', 'issueDate', 'selectedReceiverUid', 'receivedByName',
               'searchQuery', 'selectedItemId', 'quantityInput', 'cartItems',
               'includeManagerSignature', 'managerSignatureDataUrl', 'updatedAt', 'updatedAtIso'
             ]) &&
             data.draftId == draftId &&
             data.draftId == 'active_' + request.auth.uid &&
             data.draftSessionId is string &&
             data.draftSessionId.size() >= 6 &&
             data.draftSessionId.size() <= 80 &&
             data.draftSessionId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.restaurantId == restaurantId &&
             data.actorUid == request.auth.uid &&
             data.status == 'DRAFT' &&
             data.departmentId is string &&
             data.departmentId.size() <= 128 &&
             data.shift in ['MORNING', 'EVENING', 'NIGHT', 'GENERAL'] &&
             data.issueDate is string &&
             data.issueDate.size() <= 20 &&
             data.selectedReceiverUid is string &&
             data.selectedReceiverUid.size() <= 128 &&
             data.receivedByName is string &&
             data.receivedByName.size() <= 100 &&
             data.searchQuery is string &&
             data.searchQuery.size() <= 150 &&
             data.selectedItemId is string &&
             data.selectedItemId.size() <= 128 &&
             data.quantityInput is string &&
             data.quantityInput.size() <= 24 &&
             data.cartItems is list &&
             data.cartItems.size() <= 50 &&
             (data.cartItems.size() == 0 || data.cartItems[0] is map) &&
             data.includeManagerSignature is bool &&
             (
               data.managerSignatureDataUrl == null || (
                 data.managerSignatureDataUrl is string &&
                 data.managerSignatureDataUrl.matches('^data:image/png;base64,.*') &&
                 data.managerSignatureDataUrl.size() <= 130000
               )
             ) &&
             data.updatedAt is int &&
             data.updatedAt > 0 &&
             data.updatedAtIso is string &&
             data.updatedAtIso.size() >= 10 &&
             data.updatedAtIso.size() <= 40;
    }

    function isValidIssueSessionCreate(data, restaurantId) {
      return data.restaurantId == restaurantId &&
             data.issuedByUid == request.auth.uid &&
             data.issueNumber is string &&
             data.issueNumber.size() >= 4 &&
             data.issueNumber.size() <= 30 &&
             isValidIssueDateNotFuture(data.issueDate) &&
             (!('isBackdated' in data) || data.isBackdated is bool) &&
             data.createdAt is string &&
             data.createdAt.size() >= 10 &&
             data.createdAt.size() <= 40 &&
             data.departmentId is string &&
             data.departmentId.size() > 0 &&
             data.departmentName is string &&
             data.departmentName.size() > 0 &&
             data.departmentName.size() <= 120 &&
             data.shift in ['MORNING', 'EVENING', 'NIGHT', 'GENERAL'] &&
             data.receivedByName is string &&
             data.receivedByName.trim().size() > 0 &&
             data.receivedByName.size() <= 100 &&
             data.items is list &&
             data.items.size() >= 1 &&
             data.items.size() <= 50 &&
             data.totalItems is int &&
             data.totalItems == data.items.size() &&
             data.totalValue is number &&
             data.totalValue >= 0 &&
             data.receiverSignature is map &&
             data.receiverSignature.status == 'PENDING' &&
             data.managerSignature is map && (
               data.managerSignature.status == 'PENDING' || (
                 isRestaurantManager(restaurantId) &&
                 isValidIssueSignature(data.managerSignature)
               )
             );
    }

    // Root user profiles
    match /users/{userId} {
      allow get: if isUser(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isUser(userId) &&
                    request.resource.data.uid == request.auth.uid &&
                    (!('name' in request.resource.data) || isValidProfileName(request.resource.data.name));
      allow update: if isUser(userId) &&
                    (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
                    (!('email' in resource.data) || request.resource.data.get('email', '') == resource.data.get('email', '')) &&
                    (!('phone' in resource.data) || request.resource.data.get('phone', '') == resource.data.get('phone', '')) &&
                    (!('role' in resource.data) || request.resource.data.get('role', null) == resource.data.get('role', null)) &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email', 'phone', 'role', 'createdAt']) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || isValidProfileName(request.resource.data.name));
      allow delete: if isUser(userId);
    }

    // Collection group query for pending invitations by verified email
    match /{path=**}/invitations/{invitationId} {
      allow read: if isSignedIn() && (
        request.auth.token.email != null && resource.data.email == request.auth.token.email
      );
    }

    // Collection group query for active staff authorizations by verified email
    match /{path=**}/authorizations/{authorizationId} {
      allow read: if isSignedIn() && (
        request.auth.token.email != null && resource.data.email == request.auth.token.email
      );
    }

    // Multi-tenant Restaurants
    match /restaurants/{restaurantId} {
      allow get: if isMemberOfRestaurant(restaurantId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                    request.resource.data.ownerUid == request.auth.uid &&
                    request.resource.data.id == restaurantId &&
                    !exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
                    request.resource.data.name is string &&
                    request.resource.data.country is string &&
                    request.resource.data.currency is string;
      allow update: if isRestaurantManager(restaurantId) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isRestaurantOwner(restaurantId);

      // Direct Active Staff Authorizations
      match /authorizations/{authorizationId} {
        allow get, list: if isMemberOfRestaurant(restaurantId) || (
          isSignedIn() && request.auth.token.email != null && resource.data.email == request.auth.token.email
        );
        allow create: if isRestaurantManager(restaurantId) &&
                      request.resource.data.restaurantId == restaurantId &&
                      request.resource.data.status in ['ACTIVE', 'INACTIVE'] &&
                      request.resource.data.accountStatus in ['ACTIVE', 'SUSPENDED'] &&
                      request.resource.data.role in ['OWNER', 'MANAGER', 'STOREKEEPER', 'DEPARTMENT_STAFF'] &&
                      request.resource.data.authorizedByUid == request.auth.uid;
        allow update: if (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName']) ||
          isValidProfileName(request.resource.data.fullName)
        ) && (
          (
            // Owner updating authorization (cannot change own role/status/accountStatus)
            isRestaurantOwner(restaurantId) &&
            (
              resource.data.get('attachedUid', null) != request.auth.uid ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'nameUpdatedAt'])
            )
          ) || (
            // Manager updating Storekeeper/Department Staff only (cannot touch Owner/Manager or self role/status)
            isRestaurantManager(restaurantId) &&
            resource.data.get('attachedUid', null) != request.auth.uid &&
            resource.data.role in ['STOREKEEPER', 'DEPARTMENT_STAFF'] &&
            request.resource.data.role in ['STOREKEEPER', 'DEPARTMENT_STAFF'] &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['restaurantId', 'email', 'authorizedByUid'])
          ) || (
            // Authorized user attaching their authenticated uid upon login or updating their own display name
            isSignedIn() &&
            (
              (request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
              resource.data.get('attachedUid', null) == request.auth.uid
            ) &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.restaurantId == resource.data.restaurantId &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.get('accountStatus', 'ACTIVE') == resource.data.get('accountStatus', 'ACTIVE') &&
            request.resource.data.email == resource.data.email &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'role', 'restaurantId', 'status', 'accountStatus', 'email', 'authorizedByUid'
            ])
          )
        );
        allow delete: if isRestaurantManager(restaurantId);
      }

      // Authorized Staff Invitations (Legacy support)
      match /invitations/{invitationId} {
        allow get: if isSignedIn() && (
          isMemberOfRestaurant(restaurantId) ||
          (request.auth.token.email != null && resource.data.email == request.auth.token.email)
        );
        allow list: if isSignedIn() && (
          isRestaurantManager(restaurantId) ||
          (request.auth.token.email != null && resource.data.email == request.auth.token.email)
        );
        allow create: if isRestaurantManager(restaurantId) &&
                      request.resource.data.restaurantId == restaurantId &&
                      request.resource.data.requestedRole in ['OWNER', 'MANAGER', 'STOREKEEPER', 'DEPARTMENT_STAFF'] &&
                      request.resource.data.invitedByUid == request.auth.uid;
        allow update: if isRestaurantManager(restaurantId) || (
          // Invited user accepting or declining upon sign-in
          isSignedIn() &&
          request.auth.token.email != null &&
          resource.data.email == request.auth.token.email &&
          request.resource.data.requestedRole == resource.data.requestedRole &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          request.resource.data.email == resource.data.email
        );
        allow delete: if isRestaurantManager(restaurantId);
      }

      // Staff subcollection
      match /users/{userId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create: if (
          // Authorized Manager/Owner adding staff to existing restaurant
          isRestaurantManager(restaurantId) &&
          request.resource.data.role in ['OWNER', 'MANAGER', 'STOREKEEPER', 'DEPARTMENT_STAFF'] &&
          request.resource.data.restaurantId == restaurantId
        ) || (
          // Safe bootstrap for new restaurant OWNER membership
          isUser(userId) &&
          request.resource.data.role == 'OWNER' &&
          request.resource.data.restaurantId == restaurantId &&
          request.resource.data.uid == userId &&
          (
            (existsAfter(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
             getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid) ||
            (exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
             get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid)
          )
        ) || (
          // Authorized staff member linking their account to an active authorization
          isUser(userId) &&
          request.resource.data.uid == userId &&
          request.resource.data.restaurantId == restaurantId &&
          (
            (
              exists(/databases/$(database)/documents/restaurants/$(restaurantId)/authorizations/$(request.resource.data.authorizationId)) &&
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/authorizations/$(request.resource.data.authorizationId)).data.status == 'ACTIVE' &&
              request.resource.data.role == get(/databases/$(database)/documents/restaurants/$(restaurantId)/authorizations/$(request.resource.data.authorizationId)).data.role
            ) ||
            (
              exists(/databases/$(database)/documents/restaurants/$(restaurantId)/invitations/$(request.resource.data.invitationId)) &&
              request.resource.data.role == get(/databases/$(database)/documents/restaurants/$(restaurantId)/invitations/$(request.resource.data.invitationId)).data.requestedRole
            )
          )
        );
        allow update: if (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || isValidProfileName(request.resource.data.name)) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'uid', 'restaurantId', 'email', 'phone', 'createdAt', 'ownerUid'
          ])
        ) && (
          // 1. Self display name update (any role editing ONLY their own name, never role/status/permissions)
          (
            isUser(userId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameUpdatedAt'])
          ) ||
          // 2. Owner updating another staff member (cannot modify own role/status/permissions)
          (
            isRestaurantOwner(restaurantId) &&
            !isUser(userId)
          ) ||
          // 3. Manager updating Storekeeper/Department Staff (cannot modify Owner/Manager or own role/status)
          (
            isRestaurantManager(restaurantId) &&
            !isUser(userId) &&
            resource.data.role in ['STOREKEEPER', 'DEPARTMENT_STAFF'] &&
            request.resource.data.role in ['STOREKEEPER', 'DEPARTMENT_STAFF']
          ) ||
          // 4. Existing login sync safeguard for own membership without changing role/status/permissions
          (
            isUser(userId) &&
            request.resource.data.role == resource.data.role &&
            (!('ownerUid' in request.resource.data) || !('ownerUid' in resource.data) || request.resource.data.ownerUid == resource.data.ownerUid) &&
            (!('permissions' in request.resource.data) || !('permissions' in resource.data) || request.resource.data.permissions == resource.data.permissions) &&
            (!('accountStatus' in request.resource.data) || !('accountStatus' in resource.data) || request.resource.data.accountStatus == resource.data.accountStatus) &&
            (!('status' in request.resource.data) || !('status' in resource.data) || request.resource.data.status == resource.data.status) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'role', 'restaurantId', 'ownerUid', 'permissions', 'accountStatus', 'status'
            ])
          )
        );
        allow delete: if isRestaurantManager(restaurantId);
      }

      // Departments
      match /departments/{departmentId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update, delete: if isRestaurantManager(restaurantId);
      }

      // Items Master
      match /items/{itemId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create: if isStorekeeper(restaurantId) && (
          !('currentItemRate' in request.resource.data) ||
          (request.resource.data.currentItemRate is number && request.resource.data.currentItemRate >= 0)
        ) && (
          !('currentStock' in request.resource.data) ||
          (request.resource.data.currentStock is number && request.resource.data.currentStock >= 0)
        );
        allow update: if (
          !('currentItemRate' in request.resource.data) ||
          (request.resource.data.currentItemRate is number && request.resource.data.currentItemRate >= 0)
        ) && (
          !('currentStock' in request.resource.data) ||
          (request.resource.data.currentStock is number && request.resource.data.currentStock >= 0)
        ) && (
          isRestaurantManager(restaurantId) || (
            isStorekeeper(restaurantId) &&
            request.resource.data.get('status', 'active') == resource.data.get('status', 'active') &&
            request.resource.data.get('currentItemRate', null) == resource.data.get('currentItemRate', null)
          )
        );
        allow delete: if isRestaurantManager(restaurantId);
      }

      // Vendors Master
      match /vendors/{vendorId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, delete: if isRestaurantManager(restaurantId);
        allow update: if isRestaurantManager(restaurantId) || isStorekeeper(restaurantId);
      }

      // Purchases & Inward Goods
      match /purchases/{purchaseId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update: if isStorekeeper(restaurantId);
        allow delete: if isRestaurantOwner(restaurantId);
      }

      // Stock Transactions Ledger
      match /stockTransactions/{transactionId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create: if isMemberOfRestaurant(restaurantId);
        allow update, delete: if false; // Immutable ledger
      }

      // Issues to departments (item-level ledger records)
      match /issues/{issueId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create: if isStorekeeper(restaurantId) &&
          (!('issueDate' in request.resource.data) || isValidIssueDateNotFuture(request.resource.data.issueDate));
        allow update: if isStorekeeper(restaurantId) &&
          (!('issueDate' in request.resource.data) || isValidIssueDateNotFuture(request.resource.data.issueDate));
        allow delete: if isRestaurantOwner(restaurantId);
      }

      // Sequential Issue Session Counter (per restaurant)
      match /issueCounters/{counterId} {
        allow get: if isStorekeeper(restaurantId);
        allow list: if false;
        allow create, update: if isStorekeeper(restaurantId) &&
          request.resource.data.restaurantId == restaurantId &&
          request.resource.data.lastNumber is int &&
          request.resource.data.lastNumber >= 1;
        allow delete: if false;
      }

      // Store to Kitchen Issue Sessions (multi-item sessions with separate Manager & Chef/Staff signatures)
      match /issueSessions/{sessionId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create: if isStorekeeper(restaurantId) &&
          isValidIssueSessionCreate(request.resource.data, restaurantId);
        allow update: if isMemberOfRestaurant(restaurantId) && (
          // Manager / Owner capturing Manager Signature (separate approval from Receiver)
          (
            isRestaurantManager(restaurantId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerSignature', 'updatedAt']) &&
            resource.data.managerSignature.status == 'PENDING' &&
            request.resource.data.managerSignature.status == 'SIGNED' &&
            isValidIssueSignature(request.resource.data.managerSignature) &&
            resource.data.receiverSignature.get('signerUid', '') != request.auth.uid
          ) ||
          // Authorized Chef / Department Staff (or explicitly named receiver) capturing Receiving Signature
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiverSignature', 'updatedAt']) &&
            resource.data.receiverSignature.status == 'PENDING' &&
            request.resource.data.receiverSignature.status == 'SIGNED' &&
            isValidIssueSignature(request.resource.data.receiverSignature) &&
            resource.data.managerSignature.get('signerUid', '') != request.auth.uid &&
            (
              resource.data.get('receivedByUid', '') == request.auth.uid || (
                (resource.data.get('receivedByUid', null) == null || resource.data.get('receivedByUid', '') == '') &&
                exists(/databases/$(database)/documents/restaurants/$(restaurantId)/users/$(request.auth.uid)) &&
                getRestaurantUser(restaurantId).role == 'DEPARTMENT_STAFF'
              )
            )
          )
        );
        allow delete: if false; // Preserve confirmed issue session history
      }

      // Store to Kitchen Issue Drafts (auto-saved unfinished sessions — strictly tenant & user isolated, never deducts stock)
      match /issueDrafts/{draftId} {
        allow get: if isSignedIn() &&
          isValidId(restaurantId) &&
          isValidId(draftId) &&
          draftId == 'active_' + request.auth.uid &&
          isStorekeeper(restaurantId);
        allow list: if false;
        allow create: if isSignedIn() &&
          isValidId(restaurantId) &&
          isValidId(draftId) &&
          draftId == 'active_' + request.auth.uid &&
          isValidIssueSessionDraft(request.resource.data, restaurantId, draftId) &&
          isStorekeeper(restaurantId);
        allow update: if isSignedIn() &&
          isValidId(restaurantId) &&
          isValidId(draftId) &&
          draftId == 'active_' + request.auth.uid &&
          isValidIssueSessionDraft(request.resource.data, restaurantId, draftId) &&
          request.resource.data.restaurantId == resource.data.restaurantId &&
          request.resource.data.actorUid == resource.data.actorUid &&
          isStorekeeper(restaurantId);
        allow delete: if isSignedIn() &&
          isValidId(restaurantId) &&
          isValidId(draftId) &&
          draftId == 'active_' + request.auth.uid &&
          isStorekeeper(restaurantId);
      }

      // Emergency Issues
      match /emergencyIssues/{issueId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create: if isMemberOfRestaurant(restaurantId);
        allow update, delete: if isRestaurantManager(restaurantId);
      }

      // Wastage records
      match /wastage/{wastageId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update: if isStorekeeper(restaurantId);
        allow delete: if isRestaurantOwner(restaurantId);
      }

      // Stock counts & manual stock adjustments (append-only immutable audit history)
      match /stockCounts/{countId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create: if isStorekeeper(restaurantId) &&
          request.resource.data.restaurantId == restaurantId &&
          request.resource.data.countedByUid == request.auth.uid &&
          request.resource.data.itemId is string &&
          request.resource.data.itemId.size() > 0 &&
          request.resource.data.unit is string &&
          request.resource.data.unit.size() > 0 &&
          request.resource.data.unit.size() <= 30 &&
          request.resource.data.systemStock is number &&
          request.resource.data.physicalStock is number &&
          request.resource.data.physicalStock >= 0 &&
          request.resource.data.varianceQuantity is number &&
          request.resource.data.reason is string &&
          request.resource.data.reason.trim().size() > 0 &&
          request.resource.data.reason.size() <= 300;
        allow update, delete: if false; // Immutable adjustment history
      }

      // Vendor Payments
      match /vendorPayments/{paymentId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update: if isRestaurantManager(restaurantId);
        allow delete: if isRestaurantOwner(restaurantId);
      }

      // Purchase Orders
      match /purchaseOrders/{poId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update: if isStorekeeper(restaurantId);
        allow delete: if isRestaurantOwner(restaurantId) || (
          isStorekeeper(restaurantId) && resource.data.status == 'DRAFT'
        );
      }

      // Notifications
      match /notifications/{notificationId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update: if isMemberOfRestaurant(restaurantId);
        allow delete: if isRestaurantManager(restaurantId);
      }

      // Audit Logs
      match /auditLogs/{logId} {
        allow get, list: if isRestaurantManager(restaurantId);
        allow create: if isMemberOfRestaurant(restaurantId);
        allow update, delete: if false; // Immutable audit trail
      }

      // Subscriptions
      match /subscriptions/{subscriptionId} {
        allow get, list: if isRestaurantManager(restaurantId);
        allow create, update: if isRestaurantOwner(restaurantId);
        allow delete: if isRestaurantOwner(restaurantId);
      }

      // Settings (e.g. POS integration configuration, WhatsApp)
      match /settings/whatsapp {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update: if isRestaurantOwner(restaurantId) &&
                              !request.resource.data.keys().hasAny(['accessToken', 'appSecret']);
        allow delete: if isRestaurantOwner(restaurantId);
      }

      match /settings/{settingId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update, delete: if isRestaurantManager(restaurantId);
      }

      // WhatsApp Message Records & Audit Trail
      match /whatsappMessages/{messageId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update: if isStorekeeper(restaurantId);
        allow delete: if isRestaurantOwner(restaurantId);
      }

      // Recipe BOMs for POS reconciliation
      match /recipes/{recipeId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update, delete: if isRestaurantManager(restaurantId);
      }

      // POS Sales Records
      match /posSales/{saleId} {
        allow get, list: if isMemberOfRestaurant(restaurantId);
        allow create, update: if isRestaurantManager(restaurantId);
        allow delete: if isRestaurantOwner(restaurantId);
      }
    }
  }
}
